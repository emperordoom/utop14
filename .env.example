# Copy this file to .env and set local values. Never commit .env.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://utop14_dev:CHANGE_ME@localhost:5432/utop14_db

# Optional development server settings
# FLASK_DEBUG=1
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000

# Optional isolated PostgreSQL database for tests. The name must end in _test.
# TEST_DATABASE_URL=postgresql+psycopg://utop14_dev:CHANGE_ME@localhost:5432/utop14_test
