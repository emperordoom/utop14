# Copy this file to .env and set local values. Never commit .env.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://utop14_dev:CHANGE_ME@localhost:5432/utop14_db

# Optional development server settings
# FLASK_DEBUG=1
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000

# Optional isolated PostgreSQL database for tests. The name must end in _test.
# TEST_DATABASE_URL=postgresql+psycopg://utop14_dev:CHANGE_ME@localhost:5432/utop14_test

# Number of trusted reverse-proxy hops in front of the application.
# Valid values: 0-5. Default: 0 (do not trust forwarded headers).
# Set this to the exact number of trusted proxies; it must match the
# deployment topology. Keep 0 when the app is directly reachable.
TRUSTED_PROXY_HOPS=0

# Dedicated HMAC-SHA256 key for hashing unknown login identifiers.
# Production requires this key. Generate at least 32 bytes with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# When set, the key must be at least 32 bytes, must not be a placeholder, and
# must differ from SECRET_KEY. Never use SECRET_KEY as a fallback.
# If empty in development/testing, unknown identifiers are not stored and a
# once-per-process warning is logged; authentication continues normally.
SECURITY_EVENT_HASH_KEY=

# Authentication rate-limit policy. Login integration is active; registration
# remains outside this limiter until a separately approved milestone. Bucket keys
# use SECURITY_EVENT_HASH_KEY with domain separation; raw emails/IPs are never
# stored.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_BUCKET_TTL_HOURS=48
AUTH_RATE_LIMIT_IDENTIFIER_MAX_FAILURES=20
AUTH_RATE_LIMIT_IDENTIFIER_THRESHOLDS=5,10,20
AUTH_RATE_LIMIT_IDENTIFIER_COOLDOWNS=60,300,900
AUTH_RATE_LIMIT_IDENTIFIER_MAX_COOLDOWN_SECONDS=900
AUTH_RATE_LIMIT_IP_MAX_FAILURES=60
AUTH_RATE_LIMIT_IP_THRESHOLDS=30,60
AUTH_RATE_LIMIT_IP_COOLDOWNS=300,900
AUTH_RATE_LIMIT_IP_MAX_COOLDOWN_SECONDS=1800
AUTH_RATE_LIMIT_COMBINED_MAX_FAILURES=10
AUTH_RATE_LIMIT_COMBINED_THRESHOLDS=10
AUTH_RATE_LIMIT_COMBINED_COOLDOWNS=300
AUTH_RATE_LIMIT_COMBINED_MAX_COOLDOWN_SECONDS=900

# Security-event retention. M13 audit_logs are permanent and are not affected.
# Bounds: success 90-3650, failure 180-3650, max_days 1-3650 and >= both
# retention periods, hold max 1..max_days.
SECURITY_EVENT_RETENTION_ENABLED=true
SECURITY_EVENT_SUCCESS_RETENTION_DAYS=90
SECURITY_EVENT_FAILURE_RETENTION_DAYS=180
SECURITY_EVENT_RETENTION_MAX_DAYS=3650
SECURITY_EVENT_RETENTION_HOLD_MAX_DAYS=365
SECURITY_EVENT_RETENTION_BATCH_SIZE=2000
SECURITY_EVENT_RETENTION_MAX_BATCH_SIZE=5000
SECURITY_EVENT_RETENTION_MAX_BATCHES=20
SECURITY_EVENT_RETENTION_RUN_LOG_DAYS=365
# Advisory clock-skew warning threshold in seconds (1-86400). Skew never
# hard-fails the app or the retention runner.
CLOCK_SKEW_WARNING_SECONDS=120
# Dedicated runner DSN; keep credentials in a secret manager, never on the
# command line. The app role must not execute the retention functions and the
# runner has read-only run-log access plus protocol function EXECUTE.
# It must target the same PostgreSQL cluster/time source as DATABASE_URL;
# check-clock reads the application DB clock and cannot prove alignment with a
# different runner cluster.
# SECURITY_EVENT_RETENTION_DATABASE_URL=postgresql+psycopg://...
